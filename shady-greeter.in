#!/bin/sh
# Start the Shady greeter. greetd runs this as its default_session; the
# login screen (themes/<theme>/shell.lua) authenticates through greetd and
# quits the compositor once the chosen session is accepted.
#
# SHADY_GREETER_DEMO=1 fakes greetd so the greeter can be tried nested.

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=shady-greeter

# The compositor and the shell are packages of their own: these are the ones
# the greeter was built against, unless the environment names others.
: "${SHADY_GREETER_COMPOSITOR:=@shady@}"
: "${SHADY_GREETER_SHELL:=@shady_shell@}"

# SHADY_GREETER_THEME picks the look: tide (the default, shipped here), or a
# rice that brings a login screen of its own in <rice>/greeter/. Only system
# directories are searched ($SHADY_RICE_PATH, then $XDG_DATA_DIRS/shady/rices):
# the login screen sees every password.
theme="${SHADY_GREETER_THEME:-tide}"
case "$theme" in
    */*|.*|'') echo "shady-greeter: bad theme name: $theme" >&2; theme=tide ;;
esac
greeter=
if [ -f "@themedir@/$theme/config.lua" ]; then
    greeter="@themedir@/$theme"
else
    data_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    old_ifs=$IFS
    IFS=:
    for dir in ${SHADY_RICE_PATH:-} $(printf '%s' "$data_dirs" | sed 's|\([^:][^:]*\)|\1/shady/rices|g'); do
        if [ -n "$dir" ] && [ -f "$dir/$theme/greeter/config.lua" ]; then
            greeter="$dir/$theme/greeter"
            # The rice's colours and wallpaper, when it keeps them there.
            if [ -f "$dir/$theme/theme.sh" ]; then
                IFS=$old_ifs
                . "$dir/$theme/theme.sh"
            fi
            break
        fi
    done
    IFS=$old_ifs
    if [ -z "$greeter" ]; then
        echo "shady-greeter: no theme '$theme'; using tide" >&2
        greeter="@themedir@/tide"
    fi
fi
export SHADY_LUA_INIT="$greeter/init.lua"
export SHADY_SHELL_CONFIG="$greeter/shell.lua"
# If the login card cannot load, no shell at all rather than the default one
# and its launcher.
export SHADY_SHELL_NO_FALLBACK=1
# The greetd plugin sees every password: only ever the installed one, which
# the shell looks for here before anywhere else.
export SHADY_SHELL_PLUGIN_PATH="@shellplugindir@"
# The card is the only way in or out, so without it the compositor ends too
# and greetd can act on it, instead of leaving an empty screen.
shell="'$SHADY_GREETER_SHELL'; kill \"\$PPID\""

# The greeter account usually has no writable home; keep caches in the
# runtime directory instead.
if [ ! -w "${HOME:-/nonexistent}" ]; then
    export XDG_CACHE_HOME="${XDG_RUNTIME_DIR:-/tmp}/shady-greeter-cache"
fi

if [ "${SHADY_SESSION_LOG:-journal}" = journal ] && command -v systemd-cat >/dev/null 2>&1; then
    exec systemd-cat --identifier=shady-greeter -- \
        "$SHADY_GREETER_COMPOSITOR" -c "$greeter/config.lua" -s "$shell" "$@"
fi
exec "$SHADY_GREETER_COMPOSITOR" -c "$greeter/config.lua" -s "$shell" "$@"
